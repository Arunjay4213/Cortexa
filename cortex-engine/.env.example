# CortexOS Engine — Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# ── Required ──────────────────────────────────────────────────
# Admin secret for generating API keys (set to a random 32+ char string)
CORTEX_ADMIN_SECRET=changeme-set-to-random-string

# PostgreSQL password (used by both docker-compose and the engine)
POSTGRES_PASSWORD=cortex

# ── API Keys ─────────────────────────────────────────────────
# Groq API key (required — used for NLI entailment + claim decomposition)
CORTEX_GROQ_API_KEY=gsk_...

# HuggingFace token (optional — free models work without auth)
# CORTEX_HF_TOKEN=hf_...

# ── Model Mode ────────────────────────────────────────────────
# false = use Groq (NLI) + HuggingFace Inference API (embeddings) — default
# true  = use local DeBERTa + sentence-transformers (needs GPU/large RAM)
CORTEX_USE_LOCAL_MODELS=false

# ── Database (auto-configured by docker-compose) ─────────────
# CORTEX_DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/cortex
# CORTEX_DATABASE_URL_SYNC=postgresql://cortex:cortex@localhost:5432/cortex

# ── CAMA Claim Decomposition (optional) ──────────────────────
# Set these to enable LLM-based claim decomposition instead of regex fallback
# CORTEX_LLM_PROVIDER=openai
# CORTEX_LLM_API_KEY=sk-...
# CORTEX_CAMA_LLM_MODEL=gpt-4o-mini

# ── Model Overrides (optional, only when USE_LOCAL_MODELS=true) ──
# CORTEX_EMBEDDING_MODEL=all-MiniLM-L6-v2
# CORTEX_CAMA_NLI_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli

# ── Server (optional) ────────────────────────────────────────
# CORTEX_HOST=0.0.0.0
# CORTEX_PORT=8000
# CORTEX_CORS_ORIGINS=["http://localhost:3000"]
