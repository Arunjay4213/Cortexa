/* ═══════════════════════════════════════════════════════
   CortexOS Monitor — Premium Dark / Warp-inspired Theme
   ═══════════════════════════════════════════════════════

   Palette:
     #0D0D0D  background
     #1A1A1A  panel bg
     #00FF88  green  (grounded, safe, active)
     #FF3366  pink-red (hallucination, danger)
     #F5A623  amber  (warning, partial)
     #00DDFF  cyan   (metadata, latency)
     #AA44FF  purple (Shapley)
     #4488FF  blue   (memory write)
     #FF6600  orange (gate blocked)
     #888888  dim labels
     #FFFFFF  primary values
*/

/* ── Global ─────────────────────────────────────────── */
Screen {
    background: #0D0D0D;
    color: #CCCCCC;
    layers: base overlay;
}

/* ── Custom Header ──────────────────────────────────── */
#cortex-header {
    height: 3;
    dock: top;
}

#header-bar {
    height: 1;
    background: #141414;
    layout: horizontal;
    padding: 0 1;
}

#header-title {
    width: 1fr;
    color: #00FF88;
    text-style: bold;
}

#header-url {
    width: auto;
    color: #444444;
    content-align: center middle;
}

#header-event-count {
    width: auto;
    color: #444444;
    content-align: center middle;
    padding: 0 2;
}

#header-session-time {
    width: auto;
    color: #444444;
    content-align: center middle;
    padding: 0 1;
}

#header-status {
    width: auto;
    min-width: 12;
    content-align: right middle;
}

#tab-bar {
    height: 1;
    background: #0D0D0D;
    layout: horizontal;
    padding: 0 1;
}

.tab-btn {
    width: auto;
    min-width: 14;
    padding: 0 2;
    color: #444444;
    background: #0D0D0D;
}

.tab-btn.--active {
    color: #FFFFFF;
    text-style: bold;
    background: #0D0D0D;
    border-bottom: tall #00FF88;
}

#header-sep {
    height: 1;
    background: #0D0D0D;
    color: #1A1A1A;
}

/* ── Custom Footer ──────────────────────────────────── */
#cortex-footer {
    height: 1;
    dock: bottom;
    background: #141414;
    padding: 0 1;
    color: #444444;
}

/* ── Main Content ───────────────────────────────────── */
#main-content {
    height: 1fr;
}

ContentSwitcher {
    height: 1fr;
}

/* ── Tab 1: Feed ────────────────────────────────────── */
#feed-pane {
    height: 1fr;
    layout: horizontal;
}

#feed-left {
    width: 70%;
    height: 1fr;
}

#feed-panel {
    height: 1fr;
    border-left: tall #00FF88;
    padding: 0 1;
    background: #0F0F0F;
}

#feed-panel-title {
    height: 1;
    color: #00FF88;
    text-style: bold;
    padding: 0 1;
    background: #0D0D0D;
}

#feed-log {
    height: 1fr;
    background: #0F0F0F;
}

/* ListView selection cursor */
ListView > ListItem {
    background: #0F0F0F;
    padding: 0;
}

ListView > ListItem.--highlight {
    background: #172817;
}

ListView:focus > ListItem.--highlight {
    background: #1A3020;
}

#feed-right {
    width: 30%;
    height: 1fr;
    padding: 0 0 0 1;
}

#session-panel {
    height: 1fr;
    border-left: tall #4488FF;
    padding: 0 1;
    background: #0F0F0F;
}

#session-title {
    height: 1;
    color: #00DDFF;
    text-style: bold;
    padding: 0 1;
    background: #0D0D0D;
}

#session-stats {
    height: 13;
}

#sparkline-panel {
    height: 5;
    border-left: tall #00FF88;
    padding: 0 1;
    dock: bottom;
    background: #0F0F0F;
}

#sparkline-title {
    height: 1;
    color: #444444;
    padding: 0 1;
    background: #0D0D0D;
}

#sparkline-content {
    height: 1fr;
    color: #00FF88;
}

/* ── Tab 2: Claims ──────────────────────────────────── */
#claims-pane {
    height: 1fr;
    layout: vertical;
}

#claims-table {
    height: 1fr;
}

#claims-footer {
    height: 1;
    dock: bottom;
    color: #444444;
    padding: 0 1;
}

DataTable {
    height: 1fr;
}

DataTable > .datatable--header {
    background: #0A1628;
    color: #00DDFF;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1A2A1A;
}

DataTable > .datatable--header-cursor {
    background: #0A1628;
    color: #00DDFF;
    text-style: bold;
}

/* ── Tab 3: Memory ──────────────────────────────────── */
#memory-pane {
    height: 1fr;
    layout: vertical;
}

#memory-health-panel {
    height: auto;
    min-height: 8;
    max-height: 18;
    border-left: tall #AA44FF;
    padding: 0 1;
    background: #0F0F0F;
}

#memory-health-title {
    height: 1;
    color: #AA44FF;
    text-style: bold;
    padding: 0 1;
    background: #0D0D0D;
}

#memory-health-content {
    height: auto;
    padding: 0 0 1 0;
}

#memory-ops-panel {
    height: 1fr;
    border-left: tall #00FF88;
    padding: 0 1;
    background: #0F0F0F;
}

#memory-ops-title {
    height: 1;
    color: #00FF88;
    text-style: bold;
    padding: 0 1;
    background: #0D0D0D;
}

#memory-ops-log {
    height: 1fr;
}

/* ── Tab 4: Agents ──────────────────────────────────── */
#agents-pane {
    height: 1fr;
    layout: vertical;
}

#agents-table {
    height: 1fr;
}

#agents-banner {
    height: 1;
    dock: bottom;
    background: #1A0000;
    padding: 0 1;
    color: #FF3366;
    text-style: bold;
}

/* ── Tab 5: Inspect ─────────────────────────────────── */
#inspect-pane {
    height: 1fr;
    layout: vertical;
    padding: 1;
}

#inspect-empty {
    height: 1fr;
    color: #444444;
    content-align: center middle;
}

#inspect-header-bar {
    height: 3;
    padding: 1;
    border-left: tall #00DDFF;
    margin-bottom: 1;
    background: #0F0F0F;
}

#inspect-claims-section {
    height: 1fr;
    border-left: tall #00FF88;
    padding: 0 1;
    background: #0F0F0F;
}

#inspect-claims-title {
    height: 1;
    color: #00FF88;
    text-style: bold;
    padding: 0 1;
    background: #0D0D0D;
}

#inspect-claims-log {
    height: 1fr;
}

#inspect-actions {
    height: 1;
    dock: bottom;
    color: #444444;
    padding: 0 1;
}

#inspect-trace-section {
    height: 10;
    border-left: tall #AA44FF;
    padding: 0 1;
    background: #0F0F0F;
    margin-top: 1;
}

#inspect-trace-log {
    height: 1fr;
}

/* ── Command Palette Overlay ────────────────────────── */
#cmd-overlay {
    layer: overlay;
    width: 100%;
    height: 100%;
    align: center middle;
}

#cmd-panel {
    width: 60;
    height: 12;
    background: #111111;
    border: double #00FF88;
    padding: 1 2;
}

#cmd-input {
    width: 100%;
    background: #111111;
    color: #FFFFFF;
}

#cmd-hints {
    color: #444444;
    margin-top: 1;
}
